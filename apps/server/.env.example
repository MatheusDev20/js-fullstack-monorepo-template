# Port the API listens on. apps/web takes 3000 (next dev's default), so the
# server uses 3001 to avoid a clash when both run under `turbo dev`. Keep this in
# sync with NEXT_PUBLIC_BACKEND_URL in apps/web/.env.
PORT=3001

# DB
# Matches the defaults in docker-compose.yml — `pnpm db:up` brings up a
# Postgres that these values connect to out of the box.
#
# The database is opt-in: with DB_ENABLED unset (or anything other than "true")
# the app boots with no Postgres connection at all, which is what lets a fresh
# clone and the Lambda deploy start up before any DB exists.
#
# ⚠️  DB_ENABLED is the one variable this file CANNOT provide. It is read while
#     AppModule is being constructed, which happens before ConfigModule loads
#     this file, so it must be a real environment variable. `pnpm dev` defaults
#     it to true for you; override with `DB_ENABLED=false pnpm dev`.
#     Every other variable below is read through ConfigService and works fine here.
DB_ENABLED=true
DB_ENTITIES=/dist/**/*.entity.js
DB_HOST=localhost
# Host port is 5433 by default to avoid colliding with a Postgres already
# running on the standard 5432. The container still listens on 5432 internally.
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_SYNC=true
